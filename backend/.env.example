# ==============================================================================
# LAB COMPANION - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' inside the 'backend' folder:
#   cp .env.example .env
# Fill in your own database, Supabase, and SMTP credentials.
# NEVER commit the real '.env' file or real credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production, generate a secure 50+ character random key:
# py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-plus-char-secret-key-for-production

# Set to False in production! Set to True for local development.
DJANGO_DEBUG=True

# Comma-separated list of hostnames/IPs this Django site is allowed to serve:
# In development: localhost,127.0.0.1
# In production: api.yourdomain.com,your-app-name.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Set to False in production to restrict API access to trusted frontend origins:
CORS_ALLOW_ALL=True

# Allowed frontend origin URLs:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SUPABASE POSTGRESQL OR LOCAL)
# ------------------------------------------------------------------------------
# Option A: Supabase Direct Database URI (Recommended)
# From Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Option B: Individual PostgreSQL parameters
USE_POSTGRES=false
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. SUPABASE AUTH EMAIL OTP CONFIGURATION (OPTIONAL / FALLBACK)
# ------------------------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your 'Project URL' (origin only, e.g. https://xxxx.supabase.co) and 'anon public' key:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# ------------------------------------------------------------------------------
# 5. GOOGLE SMTP CONFIGURATION (DIRECT REAL-TIME OTP DELIVERY)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account (e.g. your.email@gmail.com).
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for 'Lab Companion'.
# 4. Copy the 16-character code (e.g. 'abcd efgh ijkl mnop') and paste below:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-google-app-password
DEFAULT_FROM_EMAIL="Lab Companion Security <admin@gmail.com>"

# ------------------------------------------------------------------------------
# 6. INITIAL ADMINISTRATOR ACCOUNT (SEEDED VIA python manage.py seed_data)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 7. PRODUCTION SECURITY FLAGS (Active when DJANGO_DEBUG=False)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=31536000
