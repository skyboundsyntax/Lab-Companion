# ==============================================================================
# LAB COMPANION - ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This workspace contains two coordinated components:
# 1. Backend: Django REST Framework API (see backend/.env.example)
# 2. Frontend: React + Vite Single Page Application (see frontend/.env.example)
#
# To configure your local development environment:
# - Copy 'backend/.env.example' to 'backend/.env' and fill in your Supabase & SMTP credentials.
# - Copy 'frontend/.env.example' to 'frontend/.env' if using custom API URLs.
#
# NEVER commit the real .env files to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CORE SETTINGS (Used by backend/.env)
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-random-50-plus-char-secret-key-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE SETTINGS (SUPABASE POSTGRESQL OR LOCAL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# AUTHENTICATION & EMAIL OTP (SUPABASE & GMAIL SMTP)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your.email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-google-app-password
DEFAULT_FROM_EMAIL="Lab Companion Security <admin@gmail.com>"
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (Used by frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
